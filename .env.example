# SaveRoom Pokémon Card Database local config example

# Optional: override local DB/app paths (defaults are relative to the project root)
# POKEMON_DB_DB=full_tcgdex/pokemon_tcg_set_knowledge_base.sqlite
# POKEMON_DB_UI_DIR=pokemon_db_v2_browser_ui
# POKEMON_DB_IMAGE_CACHE_DIR=image_cache/webp_q72_512
# POKEMON_DB_REPORTS_DIR=full_tcgdex/reports
# POKEMON_DB_HOST=127.0.0.1
# POKEMON_DB_PORT=8765
# POKEMON_DB_CORS_ORIGINS=http://127.0.0.1:8765,http://localhost:8765

# Pricing guardrails
POKEMON_PRICE_MONTHLY_LIMIT=1400
POKEMON_PRICE_CACHE_TTL_HOURS=168

# Do not commit real API keys. The app also reads /tmp/rapidapi_key.txt locally.
# RAPIDAPI_KEY=replace-with-your-local-key
