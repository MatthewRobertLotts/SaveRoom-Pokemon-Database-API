++        if pokemon_part in ja_to_en:
++            return ja_to_en[pokemon_part], "ja_compound_pokemon"
++
++    # Strip suffix and try Pokémon name
++    base = local_name
++    for suffix in [" ex", " EX", " V", " VMAX", " VSTAR", " GX", " LV.X",
