++def _generate_image_hash(filepath: Path) -> str:
++    """Generate a deterministic hash from file content."""
++    h = hashlib.sha256()
++    with open(filepath, 'rb') as f:
++        for chunk in iter(lambda: f.read(65536), b''):
++            h.update(chunk)
++    return h.hexdigest()[:32]
