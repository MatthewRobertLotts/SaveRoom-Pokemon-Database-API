++                ('create_policy', f'image_delivery_policies/{policy_id}',
++                 json.dumps({'scope_type': body.scope_type, 'scope_value': body.scope_value,
++                             'external_display_enabled': body.external_display_enabled}),
++                 now_val))
++            conn.commit()
