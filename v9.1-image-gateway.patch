+    POKEAPI_MAPS[lang_code] = {local: en_names[i] for i, local in enumerate(local_names) if i < len(en_names)}
+
+# Comprehensive TCG term dictionary for remaining items/trainers/energies
+TCG_TERMS_COMPREHENSIVE = {
