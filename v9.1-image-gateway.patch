++def ensure_index():
++    """Create index for efficient joins."""
++    conn = sqlite3.connect(DB_PATH)
++    cur = conn.cursor()
++    cur.execute('CREATE INDEX IF NOT EXISTS idx_v2_card_detail_card_lang ON v2_card_detail_api_cache(card_id, language_code)')
++    conn.commit()
++    conn.close()
